{
  "entities": {
    "Campaign": {
      "title": "Campaign",
      "description": "A saved Facebook and Instagram ad campaign configuration for Tidyups Cleaning Service.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the campaign owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Human-readable campaign name.",
          "minLength": 1,
          "maxLength": 120
        },
        "service": {
          "type": "string",
          "description": "Selected cleaning service key.",
          "enum": ["moveout", "deep", "standard", "movein", "recurring", "commercial", "airbnb"],
          "maxLength": 32
        },
        "tone": {
          "type": "string",
          "description": "Selected advertising angle.",
          "enum": ["trust", "urgent", "relief", "premium", "local"],
          "maxLength": 32
        },
        "format": {
          "type": "string",
          "description": "Creative aspect ratio format.",
          "enum": ["1:1", "4:5", "9:16", "16:9"],
          "maxLength": 16
        },
        "offer": {
          "type": "string",
          "description": "Optional promotional offer text.",
          "minLength": 0,
          "maxLength": 160
        },
        "area": {
          "type": "string",
          "description": "Geographic target area.",
          "minLength": 1,
          "maxLength": 120
        },
        "bookingUrl": {
          "type": "string",
          "format": "uri",
          "description": "Secure HTTPS booking destination URL.",
          "minLength": 8,
          "maxLength": 300,
          "pattern": "^https://.+$"
        },
        "businessPhone": {
          "type": "string",
          "description": "Business phone number displayed in ads.",
          "minLength": 7,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "description": "Additional creative instructions.",
          "minLength": 0,
          "maxLength": 500
        },
        "adCount": {
          "type": "integer",
          "description": "Number of ad variations in this campaign (1 to 10)."
        },
        "linkedSheetId": {
          "type": "string",
          "description": "Optional Google Sheets spreadsheet ID linked via Google Picker or created on export.",
          "minLength": 0,
          "maxLength": 128
        },
        "linkedSheetName": {
          "type": "string",
          "description": "Display title of the linked Google Sheet.",
          "minLength": 0,
          "maxLength": 200
        },
        "linkedDriveFileId": {
          "type": "string",
          "description": "Optional Google Drive file or folder ID attached via Google Picker or exported.",
          "minLength": 0,
          "maxLength": 128
        },
        "linkedDriveFileName": {
          "type": "string",
          "description": "Display name of the linked Google Drive file or folder.",
          "minLength": 0,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the campaign was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the campaign was last updated."
        }
      },
      "required": [
        "ownerId",
        "title",
        "service",
        "tone",
        "format",
        "offer",
        "area",
        "bookingUrl",
        "businessPhone",
        "notes",
        "adCount",
        "linkedSheetId",
        "linkedSheetName",
        "linkedDriveFileId",
        "linkedDriveFileName",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdVariation": {
      "title": "AdVariation",
      "description": "An individual Facebook/Instagram ad variation belonging to a parent Campaign.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the campaign owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "campaignId": {
          "type": "string",
          "description": "Document ID of the parent Campaign.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "variationNumber": {
          "type": "integer",
          "description": "1-based index of the ad variation."
        },
        "serviceName": {
          "type": "string",
          "description": "Display name of the cleaning service.",
          "minLength": 1,
          "maxLength": 80
        },
        "format": {
          "type": "string",
          "description": "Creative aspect ratio format.",
          "enum": ["1:1", "4:5", "9:16", "16:9"],
          "maxLength": 16
        },
        "headline": {
          "type": "string",
          "description": "Ad headline copy.",
          "minLength": 1,
          "maxLength": 150
        },
        "primaryText": {
          "type": "string",
          "description": "Ad primary body copy.",
          "minLength": 1,
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "description": "Link description copy.",
          "minLength": 1,
          "maxLength": 300
        },
        "cta": {
          "type": "string",
          "description": "Call-to-action label.",
          "minLength": 1,
          "maxLength": 40
        },
        "destinationUrl": {
          "type": "string",
          "format": "uri",
          "description": "HTTPS destination URL for the ad.",
          "minLength": 8,
          "maxLength": 300,
          "pattern": "^https://.+$"
        },
        "imagePrompt": {
          "type": "string",
          "description": "Photorealistic image generation prompt.",
          "minLength": 1,
          "maxLength": 2000
        },
        "videoScript": {
          "type": "string",
          "description": "10-second short-form video script.",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the ad variation was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the ad variation was last updated."
        }
      },
      "required": [
        "ownerId",
        "campaignId",
        "variationNumber",
        "serviceName",
        "format",
        "headline",
        "primaryText",
        "description",
        "cta",
        "destinationUrl",
        "imagePrompt",
        "videoScript",
        "createdAt",
        "updatedAt"
      ]
    },
    "CreativeAsset": {
      "title": "CreativeAsset",
      "description": "A saved portfolio item created in the Image Ad Creator, Video Ad Creator, or Logo & Icon Studio.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the portfolio owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "description": "Portfolio section where this asset belongs.",
          "enum": ["ad-image", "video-ad", "brand-logo", "brand-icon"],
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "description": "Human-readable title of the generated creative.",
          "minLength": 1,
          "maxLength": 140
        },
        "prompt": {
          "type": "string",
          "description": "Prompt or script used to generate the creative.",
          "minLength": 1,
          "maxLength": 2000
        },
        "service": {
          "type": "string",
          "description": "Associated cleaning service or brand category.",
          "enum": ["moveout", "deep", "standard", "movein", "recurring", "commercial", "airbnb", "brand"],
          "maxLength": 32
        },
        "aspectRatio": {
          "type": "string",
          "description": "Aspect ratio of the creative.",
          "enum": ["1:1", "3:4", "4:3", "4:5", "9:16", "16:9"],
          "maxLength": 16
        },
        "modelUsed": {
          "type": "string",
          "description": "Identifier of the model or generator used.",
          "minLength": 1,
          "maxLength": 80
        },
        "previewDataUrl": {
          "type": "string",
          "description": "Compact compressed WebP/JPEG thumbnail preview data URL (< 180 KB) for fast portfolio rendering within Firestore limits.",
          "minLength": 0,
          "maxLength": 180000
        },
        "svgMarkup": {
          "type": "string",
          "description": "Optional vector SVG markup for vector logos and icons.",
          "minLength": 0,
          "maxLength": 40000
        },
        "durationLabel": {
          "type": "string",
          "description": "Optional video clip duration label (e.g. 6s, 10s).",
          "minLength": 0,
          "maxLength": 24
        },
        "interactionId": {
          "type": "string",
          "description": "Optional Gemini Interactions API ID for multi-turn video editing or extension.",
          "minLength": 0,
          "maxLength": 160
        },
        "driveFileId": {
          "type": "string",
          "description": "Optional Google Drive file ID where the full-resolution PNG or MP4 is backed up.",
          "minLength": 0,
          "maxLength": 128
        },
        "driveWebViewLink": {
          "type": "string",
          "description": "Optional Google Drive webViewLink URL for the backed-up full-resolution file.",
          "minLength": 0,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the portfolio asset was saved."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the portfolio asset was last updated."
        }
      },
      "required": [
        "ownerId",
        "category",
        "title",
        "prompt",
        "service",
        "aspectRatio",
        "modelUsed",
        "previewDataUrl",
        "svgMarkup",
        "durationLabel",
        "interactionId",
        "driveFileId",
        "driveWebViewLink",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingRequest": {
      "title": "BookingRequest",
      "description": "An online residential or commercial cleaning quote and booking request submitted via /booking.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the signed-in user who saved the booking.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referenceCode": {
          "type": "string",
          "description": "Human-readable booking confirmation code (e.g., TU-849201).",
          "minLength": 9,
          "maxLength": 16,
          "pattern": "^TU-[A-Z0-9]{6,12}$"
        },
        "service": {
          "type": "string",
          "description": "Selected cleaning service key.",
          "enum": ["moveout", "deep", "standard", "movein", "recurring", "commercial", "airbnb"],
          "maxLength": 32
        },
        "frequency": {
          "type": "string",
          "description": "Cleaning schedule frequency.",
          "enum": ["once", "weekly", "biweekly", "monthly"],
          "maxLength": 24
        },
        "bedrooms": {
          "type": "integer",
          "description": "Number of bedrooms or office rooms (0 to 10)."
        },
        "bathrooms": {
          "type": "integer",
          "description": "Number of bathrooms (1 to 8)."
        },
        "sqftTier": {
          "type": "string",
          "description": "Approximate property square footage tier.",
          "enum": ["under1000", "1000to1800", "1800to2600", "over2600"],
          "maxLength": 24
        },
        "addOnsSummary": {
          "type": "string",
          "description": "Comma-separated summary of selected detail add-ons.",
          "minLength": 0,
          "maxLength": 240
        },
        "preferredDate": {
          "type": "string",
          "description": "Requested cleaning service date (YYYY-MM-DD).",
          "minLength": 8,
          "maxLength": 20
        },
        "arrivalWindow": {
          "type": "string",
          "description": "Preferred arrival window.",
          "enum": ["morning", "midday", "afternoon"],
          "maxLength": 24
        },
        "estimatedTotalCad": {
          "type": "integer",
          "description": "Estimated total in CAD including GST (50 to 25000)."
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name (PII isolated to owner).",
          "minLength": 2,
          "maxLength": 100
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "description": "Customer email address (PII isolated to owner).",
          "minLength": 5,
          "maxLength": 160
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone number (PII isolated to owner).",
          "minLength": 7,
          "maxLength": 40
        },
        "serviceAddress": {
          "type": "string",
          "description": "Edmonton-area service street address (PII isolated to owner).",
          "minLength": 5,
          "maxLength": 240
        },
        "notes": {
          "type": "string",
          "description": "Optional entry, parking, or pet instructions.",
          "minLength": 0,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Current booking lifecycle status.",
          "enum": ["requested", "confirmed", "cancelled"],
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the booking request was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the booking request was last updated."
        }
      },
      "required": [
        "ownerId",
        "referenceCode",
        "service",
        "frequency",
        "bedrooms",
        "bathrooms",
        "sqftTier",
        "addOnsSummary",
        "preferredDate",
        "arrivalWindow",
        "estimatedTotalCad",
        "customerName",
        "customerEmail",
        "customerPhone",
        "serviceAddress",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomerInquiry": {
      "title": "CustomerInquiry",
      "description": "A support ticket or contact inquiry submitted via /support or /contact.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the signed-in user who submitted the inquiry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ticketCode": {
          "type": "string",
          "description": "Human-readable support/contact reference code (e.g., SUP-492018).",
          "minLength": 10,
          "maxLength": 16,
          "pattern": "^SUP-[A-Z0-9]{6,12}$"
        },
        "channel": {
          "type": "string",
          "description": "Originating page channel.",
          "enum": ["contact", "support"],
          "maxLength": 24
        },
        "category": {
          "type": "string",
          "description": "Inquiry topic classification.",
          "enum": ["quote", "commercial", "reschedule", "guarantee", "billing", "workspace", "general"],
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "description": "Sender full name (PII isolated to owner).",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender email address (PII isolated to owner).",
          "minLength": 5,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Optional sender phone number (PII isolated to owner).",
          "minLength": 0,
          "maxLength": 40
        },
        "bookingRef": {
          "type": "string",
          "description": "Optional associated booking reference code.",
          "minLength": 0,
          "maxLength": 32
        },
        "message": {
          "type": "string",
          "description": "Detailed inquiry or support request message.",
          "minLength": 5,
          "maxLength": 1500
        },
        "status": {
          "type": "string",
          "description": "Ticket lifecycle status.",
          "enum": ["open", "resolved"],
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the inquiry was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the inquiry was last updated."
        }
      },
      "required": [
        "ownerId",
        "ticketCode",
        "channel",
        "category",
        "name",
        "email",
        "phone",
        "bookingRef",
        "message",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Top-level saved ad campaigns isolated per authenticated owner."
    },
    "/campaigns/{campaignId}/ads/{adId}": {
      "schema": "AdVariation",
      "description": "Subcollection of generated ad variations belonging to a parent campaign."
    },
    "/creativeAssets/{assetId}": {
      "schema": "CreativeAsset",
      "description": "Top-level portfolio storage for generated ad images, video ads, logos, and icons isolated per authenticated owner."
    },
    "/bookingRequests/{bookingId}": {
      "schema": "BookingRequest",
      "description": "Top-level online cleaning booking requests containing customer PII strictly isolated per authenticated owner."
    },
    "/inquiries/{inquiryId}": {
      "schema": "CustomerInquiry",
      "description": "Top-level support tickets and contact inquiries strictly isolated per authenticated owner."
    }
  }
}
