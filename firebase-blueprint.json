{
  "entities": {
    "Campaign": {
      "title": "Campaign",
      "description": "A saved Facebook and Instagram ad campaign configuration for Tidyups Cleaning Service.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the campaign owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Human-readable campaign name.",
          "minLength": 1,
          "maxLength": 120
        },
        "service": {
          "type": "string",
          "description": "Selected cleaning service key.",
          "enum": ["moveout", "deep", "standard", "movein", "recurring", "commercial", "airbnb"],
          "maxLength": 32
        },
        "tone": {
          "type": "string",
          "description": "Selected advertising angle.",
          "enum": ["trust", "urgent", "relief", "premium", "local"],
          "maxLength": 32
        },
        "format": {
          "type": "string",
          "description": "Creative aspect ratio format.",
          "enum": ["1:1", "4:5", "9:16", "16:9"],
          "maxLength": 16
        },
        "offer": {
          "type": "string",
          "description": "Optional promotional offer text.",
          "minLength": 0,
          "maxLength": 160
        },
        "area": {
          "type": "string",
          "description": "Geographic target area.",
          "minLength": 1,
          "maxLength": 120
        },
        "bookingUrl": {
          "type": "string",
          "format": "uri",
          "description": "Secure HTTPS booking destination URL.",
          "minLength": 8,
          "maxLength": 300,
          "pattern": "^https://.+$"
        },
        "businessPhone": {
          "type": "string",
          "description": "Business phone number displayed in ads.",
          "minLength": 7,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "description": "Additional creative instructions.",
          "minLength": 0,
          "maxLength": 500
        },
        "adCount": {
          "type": "integer",
          "description": "Number of ad variations in this campaign (1 to 10)."
        },
        "linkedSheetId": {
          "type": "string",
          "description": "Optional Google Sheets spreadsheet ID linked via Google Picker or created on export.",
          "minLength": 0,
          "maxLength": 128
        },
        "linkedSheetName": {
          "type": "string",
          "description": "Display title of the linked Google Sheet.",
          "minLength": 0,
          "maxLength": 200
        },
        "linkedDriveFileId": {
          "type": "string",
          "description": "Optional Google Drive file ID attached via Google Picker or exported.",
          "minLength": 0,
          "maxLength": 128
        },
        "linkedDriveFileName": {
          "type": "string",
          "description": "Display name of the linked Google Drive file.",
          "minLength": 0,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the campaign was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the campaign was last updated."
        }
      },
      "required": [
        "ownerId",
        "title",
        "service",
        "tone",
        "format",
        "offer",
        "area",
        "bookingUrl",
        "businessPhone",
        "notes",
        "adCount",
        "linkedSheetId",
        "linkedSheetName",
        "linkedDriveFileId",
        "linkedDriveFileName",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdVariation": {
      "title": "AdVariation",
      "description": "An individual Facebook/Instagram ad variation belonging to a parent Campaign.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the campaign owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "campaignId": {
          "type": "string",
          "description": "Document ID of the parent Campaign.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "variationNumber": {
          "type": "integer",
          "description": "1-based index of the ad variation."
        },
        "serviceName": {
          "type": "string",
          "description": "Display name of the cleaning service.",
          "minLength": 1,
          "maxLength": 80
        },
        "format": {
          "type": "string",
          "description": "Creative aspect ratio format.",
          "enum": ["1:1", "4:5", "9:16", "16:9"],
          "maxLength": 16
        },
        "headline": {
          "type": "string",
          "description": "Ad headline copy.",
          "minLength": 1,
          "maxLength": 150
        },
        "primaryText": {
          "type": "string",
          "description": "Ad primary body copy.",
          "minLength": 1,
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "description": "Link description copy.",
          "minLength": 1,
          "maxLength": 300
        },
        "cta": {
          "type": "string",
          "description": "Call-to-action label.",
          "minLength": 1,
          "maxLength": 40
        },
        "destinationUrl": {
          "type": "string",
          "format": "uri",
          "description": "HTTPS destination URL for the ad.",
          "minLength": 8,
          "maxLength": 300,
          "pattern": "^https://.+$"
        },
        "imagePrompt": {
          "type": "string",
          "description": "Photorealistic image generation prompt.",
          "minLength": 1,
          "maxLength": 2000
        },
        "videoScript": {
          "type": "string",
          "description": "10-second short-form video script.",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the ad variation was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the ad variation was last updated."
        }
      },
      "required": [
        "ownerId",
        "campaignId",
        "variationNumber",
        "serviceName",
        "format",
        "headline",
        "primaryText",
        "description",
        "cta",
        "destinationUrl",
        "imagePrompt",
        "videoScript",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Top-level saved ad campaigns isolated per authenticated owner."
    },
    "/campaigns/{campaignId}/ads/{adId}": {
      "schema": "AdVariation",
      "description": "Subcollection of generated ad variations belonging to a parent campaign."
    }
  }
}
