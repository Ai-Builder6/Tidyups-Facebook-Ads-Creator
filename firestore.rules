rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isParentCampaignOwner(campaignId) {
      return exists(/databases/$(database)/documents/campaigns/$(campaignId))
        && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid;
    }

    function isParentCampaignOwnerAfter(campaignId) {
      return existsAfter(/databases/$(database)/documents/campaigns/$(campaignId))
        && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid;
    }

    // Pillar 2: Validation Blueprints (Synchronized verbatim with firebase-blueprint.json)
    function isValidCampaign(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'service',
          'tone',
          'format',
          'offer',
          'area',
          'bookingUrl',
          'businessPhone',
          'notes',
          'adCount',
          'linkedSheetId',
          'linkedSheetName',
          'linkedDriveFileId',
          'linkedDriveFileName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'service',
          'tone',
          'format',
          'offer',
          'area',
          'bookingUrl',
          'businessPhone',
          'notes',
          'adCount',
          'linkedSheetId',
          'linkedSheetName',
          'linkedDriveFileId',
          'linkedDriveFileName',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data['service'] is string
        && data['service'].size() <= 32
        && data['service'] in ['moveout', 'deep', 'standard', 'movein', 'recurring', 'commercial', 'airbnb']
        && data.tone is string
        && data.tone.size() <= 32
        && data.tone in ['trust', 'urgent', 'relief', 'premium', 'local']
        && data.format is string
        && data.format.size() <= 16
        && data.format in ['1:1', '4:5', '9:16', '16:9']
        && data.offer is string
        && data.offer.size() <= 160
        && data.area is string
        && data.area.size() >= 1
        && data.area.size() <= 120
        && data.bookingUrl is string
        && data.bookingUrl.size() >= 8
        && data.bookingUrl.size() <= 300
        && data.bookingUrl.matches('^https://.+$')
        && data.businessPhone is string
        && data.businessPhone.size() >= 7
        && data.businessPhone.size() <= 40
        && data.notes is string
        && data.notes.size() <= 500
        && data.adCount is int
        && data.adCount >= 1
        && data.adCount <= 10
        && data.linkedSheetId is string
        && data.linkedSheetId.size() <= 128
        && data.linkedSheetName is string
        && data.linkedSheetName.size() <= 200
        && data.linkedDriveFileId is string
        && data.linkedDriveFileId.size() <= 128
        && data.linkedDriveFileName is string
        && data.linkedDriveFileName.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdVariation(data, campaignId) {
      return data.keys().hasAll([
          'ownerId',
          'campaignId',
          'variationNumber',
          'serviceName',
          'format',
          'headline',
          'primaryText',
          'description',
          'cta',
          'destinationUrl',
          'imagePrompt',
          'videoScript',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'campaignId',
          'variationNumber',
          'serviceName',
          'format',
          'headline',
          'primaryText',
          'description',
          'cta',
          'destinationUrl',
          'imagePrompt',
          'videoScript',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.campaignId is string
        && data.campaignId.size() >= 1
        && data.campaignId.size() <= 128
        && data.campaignId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.campaignId == campaignId
        && data.variationNumber is int
        && data.variationNumber >= 1
        && data.variationNumber <= 20
        && data.serviceName is string
        && data.serviceName.size() >= 1
        && data.serviceName.size() <= 80
        && data.format is string
        && data.format.size() <= 16
        && data.format in ['1:1', '4:5', '9:16', '16:9']
        && data.headline is string
        && data.headline.size() >= 1
        && data.headline.size() <= 150
        && data.primaryText is string
        && data.primaryText.size() >= 1
        && data.primaryText.size() <= 2000
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 300
        && data.cta is string
        && data.cta.size() >= 1
        && data.cta.size() <= 40
        && data.destinationUrl is string
        && data.destinationUrl.size() >= 8
        && data.destinationUrl.size() <= 300
        && data.destinationUrl.matches('^https://.+$')
        && data.imagePrompt is string
        && data.imagePrompt.size() >= 1
        && data.imagePrompt.size() <= 2000
        && data.videoScript is string
        && data.videoScript.size() >= 1
        && data.videoScript.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCreativeAsset(data) {
      return data.keys().hasAll([
          'ownerId',
          'category',
          'title',
          'prompt',
          'service',
          'aspectRatio',
          'modelUsed',
          'previewDataUrl',
          'svgMarkup',
          'durationLabel',
          'interactionId',
          'driveFileId',
          'driveWebViewLink',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'category',
          'title',
          'prompt',
          'service',
          'aspectRatio',
          'modelUsed',
          'previewDataUrl',
          'svgMarkup',
          'durationLabel',
          'interactionId',
          'driveFileId',
          'driveWebViewLink',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.category is string
        && data.category.size() <= 24
        && data.category in ['ad-image', 'video-ad', 'brand-logo', 'brand-icon']
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && data.prompt is string
        && data.prompt.size() >= 1
        && data.prompt.size() <= 2000
        && data['service'] is string
        && data['service'].size() <= 32
        && data['service'] in ['moveout', 'deep', 'standard', 'movein', 'recurring', 'commercial', 'airbnb', 'brand']
        && data.aspectRatio is string
        && data.aspectRatio.size() <= 16
        && data.aspectRatio in ['1:1', '3:4', '4:3', '4:5', '9:16', '16:9']
        && data.modelUsed is string
        && data.modelUsed.size() >= 1
        && data.modelUsed.size() <= 80
        && data.previewDataUrl is string
        && data.previewDataUrl.size() <= 180000
        && data.svgMarkup is string
        && data.svgMarkup.size() <= 40000
        && data.durationLabel is string
        && data.durationLabel.size() <= 24
        && data.interactionId is string
        && data.interactionId.size() <= 160
        && data.driveFileId is string
        && data.driveFileId.size() <= 128
        && data.driveWebViewLink is string
        && data.driveWebViewLink.size() <= 400
        && (data.driveWebViewLink.size() == 0 || data.driveWebViewLink.matches('^https://.+$'))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookingRequest(data) {
      return data.keys().hasAll([
          'ownerId',
          'referenceCode',
          'service',
          'frequency',
          'bedrooms',
          'bathrooms',
          'sqftTier',
          'addOnsSummary',
          'preferredDate',
          'arrivalWindow',
          'estimatedTotalCad',
          'customerName',
          'customerEmail',
          'customerPhone',
          'serviceAddress',
          'notes',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'referenceCode',
          'service',
          'frequency',
          'bedrooms',
          'bathrooms',
          'sqftTier',
          'addOnsSummary',
          'preferredDate',
          'arrivalWindow',
          'estimatedTotalCad',
          'customerName',
          'customerEmail',
          'customerPhone',
          'serviceAddress',
          'notes',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.referenceCode is string
        && data.referenceCode.size() >= 9
        && data.referenceCode.size() <= 16
        && data.referenceCode.matches('^TU-[A-Z0-9]{6,12}$')
        && data['service'] is string
        && data['service'].size() <= 32
        && data['service'] in ['moveout', 'deep', 'standard', 'movein', 'recurring', 'commercial', 'airbnb']
        && data.frequency is string
        && data.frequency.size() <= 24
        && data.frequency in ['once', 'weekly', 'biweekly', 'monthly']
        && data.bedrooms is int
        && data.bedrooms >= 0
        && data.bedrooms <= 10
        && data.bathrooms is int
        && data.bathrooms >= 1
        && data.bathrooms <= 8
        && data.sqftTier is string
        && data.sqftTier.size() <= 24
        && data.sqftTier in ['under1000', '1000to1800', '1800to2600', 'over2600']
        && data.addOnsSummary is string
        && data.addOnsSummary.size() <= 240
        && data.preferredDate is string
        && data.preferredDate.size() >= 8
        && data.preferredDate.size() <= 20
        && data.arrivalWindow is string
        && data.arrivalWindow.size() <= 24
        && data.arrivalWindow in ['morning', 'midday', 'afternoon']
        && data.estimatedTotalCad is int
        && data.estimatedTotalCad >= 50
        && data.estimatedTotalCad <= 25000
        && data.customerName is string
        && data.customerName.size() >= 2
        && data.customerName.size() <= 100
        && data.customerEmail is string
        && data.customerEmail.size() >= 5
        && data.customerEmail.size() <= 160
        && data.customerPhone is string
        && data.customerPhone.size() >= 7
        && data.customerPhone.size() <= 40
        && data.serviceAddress is string
        && data.serviceAddress.size() >= 5
        && data.serviceAddress.size() <= 240
        && data.notes is string
        && data.notes.size() <= 500
        && data.status is string
        && data.status.size() <= 24
        && data.status in ['requested', 'confirmed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomerInquiry(data) {
      return data.keys().hasAll([
          'ownerId',
          'ticketCode',
          'channel',
          'category',
          'name',
          'email',
          'phone',
          'bookingRef',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'ticketCode',
          'channel',
          'category',
          'name',
          'email',
          'phone',
          'bookingRef',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.ticketCode is string
        && data.ticketCode.size() >= 10
        && data.ticketCode.size() <= 16
        && data.ticketCode.matches('^SUP-[A-Z0-9]{6,12}$')
        && data.channel is string
        && data.channel.size() <= 24
        && data.channel in ['contact', 'support']
        && data.category is string
        && data.category.size() <= 32
        && data.category in ['quote', 'commercial', 'reschedule', 'guarantee', 'billing', 'workspace', 'general']
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 160
        && data.phone is string
        && data.phone.size() <= 40
        && data.bookingRef is string
        && data.bookingRef.size() <= 32
        && data.message is string
        && data.message.size() >= 5
        && data.message.size() <= 1500
        && data.status is string
        && data.status.size() <= 24
        && data.status in ['open', 'resolved']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /campaigns/{campaignId}
    match /campaigns/{campaignId} {
      allow get: if isSignedIn()
        && isValidId(campaignId)
        && existing().ownerId == request.auth.uid;

      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(campaignId)
        && isValidCampaign(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(campaignId)
        && isValidCampaign(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'service',
            'tone',
            'format',
            'offer',
            'area',
            'bookingUrl',
            'businessPhone',
            'notes',
            'adCount',
            'linkedSheetId',
            'linkedSheetName',
            'linkedDriveFileId',
            'linkedDriveFileName',
            'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'linkedSheetId',
            'linkedSheetName',
            'linkedDriveFileId',
            'linkedDriveFileName',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(campaignId)
        && existing().ownerId == request.auth.uid;

      // Subcollection: /campaigns/{campaignId}/ads/{adId}
      match /ads/{adId} {
        allow get: if isSignedIn()
          && isValidId(campaignId)
          && isValidId(adId)
          && existing().ownerId == request.auth.uid
          && isParentCampaignOwner(campaignId);

        allow list: if isSignedIn()
          && existing().ownerId == request.auth.uid
          && existing().campaignId == campaignId;

        allow create: if isVerifiedUser()
          && isValidId(campaignId)
          && isValidId(adId)
          && isValidAdVariation(incoming(), campaignId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isParentCampaignOwnerAfter(campaignId);

        allow update: if isVerifiedUser()
          && isValidId(campaignId)
          && isValidId(adId)
          && isValidAdVariation(incoming(), campaignId)
          && existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().campaignId == existing().campaignId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'variationNumber',
            'serviceName',
            'format',
            'headline',
            'primaryText',
            'description',
            'cta',
            'destinationUrl',
            'imagePrompt',
            'videoScript',
            'updatedAt'
          ])
          && isParentCampaignOwner(campaignId);

        allow delete: if isVerifiedUser()
          && isValidId(campaignId)
          && isValidId(adId)
          && existing().ownerId == request.auth.uid
          && isParentCampaignOwner(campaignId);
      }
    }

    // Collection: /creativeAssets/{assetId}
    match /creativeAssets/{assetId} {
      allow get: if isSignedIn()
        && isValidId(assetId)
        && existing().ownerId == request.auth.uid;

      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(assetId)
        && isValidCreativeAsset(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(assetId)
        && isValidCreativeAsset(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().category == existing().category
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'driveFileId',
          'driveWebViewLink',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(assetId)
        && existing().ownerId == request.auth.uid;
    }

    // Collection: /bookingRequests/{bookingId} (PII Isolated + Terminal State Locked)
    match /bookingRequests/{bookingId} {
      allow get: if isSignedIn()
        && isValidId(bookingId)
        && existing().ownerId == request.auth.uid;

      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidBookingRequest(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidBookingRequest(incoming())
        && existing().ownerId == request.auth.uid
        && existing().status != 'cancelled'
        && incoming().ownerId == existing().ownerId
        && incoming().referenceCode == existing().referenceCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'preferredDate',
            'arrivalWindow',
            'notes',
            'status',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser()
        && isValidId(bookingId)
        && existing().ownerId == request.auth.uid;
    }

    // Collection: /inquiries/{inquiryId} (PII Isolated + Terminal State Locked)
    match /inquiries/{inquiryId} {
      allow get: if isSignedIn()
        && isValidId(inquiryId)
        && existing().ownerId == request.auth.uid;

      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(inquiryId)
        && isValidCustomerInquiry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(inquiryId)
        && isValidCustomerInquiry(incoming())
        && existing().ownerId == request.auth.uid
        && existing().status != 'resolved'
        && incoming().ownerId == existing().ownerId
        && incoming().ticketCode == existing().ticketCode
        && incoming().channel == existing().channel
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(inquiryId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
