{
  "entities": {
    "Campaign": {
      "title": "Campaign",
      "description": "A saved Facebook and Instagram ad campaign configuration for Tidyups Cleaning Service.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the campaign owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Human-readable campaign name.",
          "minLength": 1,
          "maxLength": 120
        },
        "service": {
          "type": "string",
          "description": "Selected cleaning service key.",
          "enum": ["moveout", "deep", "standard", "movein", "recurring", "commercial", "airbnb"],
          "maxLength": 32
        },
        "tone": {
          "type": "string",
          "description": "Selected advertising angle.",
          "enum": ["trust", "urgent", "relief", "premium", "local"],
          "maxLength": 32
        },
        "format": {
          "type": "string",
          "description": "Creative aspect ratio format.",
          "enum": ["1:1", "4:5", "9:16", "16:9"],
          "maxLength": 16
        },
        "offer": {
          "type": "string",
          "description": "Optional promotional offer text.",
          "minLength": 0,
          "maxLength": 160
        },
        "area": {
          "type": "string",
          "description": "Geographic target area.",
          "minLength": 1,
          "maxLength": 120
        },
        "bookingUrl": {
          "type": "string",
          "format": "uri",
          "description": "Secure HTTPS booking destination URL.",
          "minLength": 8,
          "maxLength": 300,
          "pattern": "^https://.+$"
        },
        "businessPhone": {
          "type": "string",
          "description": "Business phone number displayed in ads.",
          "minLength": 7,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "description": "Additional creative instructions.",
          "minLength": 0,
          "maxLength": 500
        },
        "adCount": {
          "type": "integer",
          "description": "Number of ad variations in this campaign (1 to 10)."
        },
        "linkedSheetId": {
          "type": "string",
          "description": "Optional Google Sheets spreadsheet ID linked via Google Picker or created on export.",
          "minLength": 0,
          "maxLength": 128
        },
        "linkedSheetName": {
          "type": "string",
          "description": "Display title of the linked Google Sheet.",
          "minLength": 0,
          "maxLength": 200
        },
        "linkedDriveFileId": {
          "type": "string",
          "description": "Optional Google Drive file or folder ID attached via Google Picker or exported.",
          "minLength": 0,
          "maxLength": 128
        },
        "linkedDriveFileName": {
          "type": "string",
          "description": "Display name of the linked Google Drive file or folder.",
          "minLength": 0,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the campaign was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the campaign was last updated."
        }
      },
      "required": [
        "ownerId",
        "title",
        "service",
        "tone",
        "format",
        "offer",
        "area",
        "bookingUrl",
        "businessPhone",
        "notes",
        "adCount",
        "linkedSheetId",
        "linkedSheetName",
        "linkedDriveFileId",
        "linkedDriveFileName",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdVariation": {
      "title": "AdVariation",
      "description": "An individual Facebook/Instagram ad variation belonging to a parent Campaign.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the campaign owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "campaignId": {
          "type": "string",
          "description": "Document ID of the parent Campaign.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "variationNumber": {
          "type": "integer",
          "description": "1-based index of the ad variation."
        },
        "serviceName": {
          "type": "string",
          "description": "Display name of the cleaning service.",
          "minLength": 1,
          "maxLength": 80
        },
        "format": {
          "type": "string",
          "description": "Creative aspect ratio format.",
          "enum": ["1:1", "4:5", "9:16", "16:9"],
          "maxLength": 16
        },
        "headline": {
          "type": "string",
          "description": "Ad headline copy.",
          "minLength": 1,
          "maxLength": 150
        },
        "primaryText": {
          "type": "string",
          "description": "Ad primary body copy.",
          "minLength": 1,
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "description": "Link description copy.",
          "minLength": 1,
          "maxLength": 300
        },
        "cta": {
          "type": "string",
          "description": "Call-to-action label.",
          "minLength": 1,
          "maxLength": 40
        },
        "destinationUrl": {
          "type": "string",
          "format": "uri",
          "description": "HTTPS destination URL for the ad.",
          "minLength": 8,
          "maxLength": 300,
          "pattern": "^https://.+$"
        },
        "imagePrompt": {
          "type": "string",
          "description": "Photorealistic image generation prompt.",
          "minLength": 1,
          "maxLength": 2000
        },
        "videoScript": {
          "type": "string",
          "description": "10-second short-form video script.",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the ad variation was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the ad variation was last updated."
        }
      },
      "required": [
        "ownerId",
        "campaignId",
        "variationNumber",
        "serviceName",
        "format",
        "headline",
        "primaryText",
        "description",
        "cta",
        "destinationUrl",
        "imagePrompt",
        "videoScript",
        "createdAt",
        "updatedAt"
      ]
    },
    "CreativeAsset": {
      "title": "CreativeAsset",
      "description": "A saved portfolio item created in the Image Ad Creator, Video Ad Creator, or Logo & Icon Studio.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the portfolio owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "description": "Portfolio section where this asset belongs.",
          "enum": ["ad-image", "video-ad", "brand-logo", "brand-icon"],
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "description": "Human-readable title of the generated creative.",
          "minLength": 1,
          "maxLength": 140
        },
        "prompt": {
          "type": "string",
          "description": "Prompt or script used to generate the creative.",
          "minLength": 1,
          "maxLength": 2000
        },
        "service": {
          "type": "string",
          "description": "Associated cleaning service or brand category.",
          "enum": ["moveout", "deep", "standard", "movein", "recurring", "commercial", "airbnb", "brand"],
          "maxLength": 32
        },
        "aspectRatio": {
          "type": "string",
          "description": "Aspect ratio of the creative.",
          "enum": ["1:1", "3:4", "4:3", "4:5", "9:16", "16:9"],
          "maxLength": 16
        },
        "modelUsed": {
          "type": "string",
          "description": "Identifier of the model or generator used.",
          "minLength": 1,
          "maxLength": 80
        },
        "previewDataUrl": {
          "type": "string",
          "description": "Compact compressed WebP/JPEG thumbnail preview data URL (< 180 KB) for fast portfolio rendering within Firestore limits.",
          "minLength": 0,
          "maxLength": 180000
        },
        "svgMarkup": {
          "type": "string",
          "description": "Optional vector SVG markup for vector logos and icons.",
          "minLength": 0,
          "maxLength": 40000
        },
        "durationLabel": {
          "type": "string",
          "description": "Optional video clip duration label (e.g. 6s, 10s).",
          "minLength": 0,
          "maxLength": 24
        },
        "interactionId": {
          "type": "string",
          "description": "Optional Gemini Interactions API ID for multi-turn video editing or extension.",
          "minLength": 0,
          "maxLength": 160
        },
        "driveFileId": {
          "type": "string",
          "description": "Optional Google Drive file ID where the full-resolution PNG or MP4 is backed up.",
          "minLength": 0,
          "maxLength": 128
        },
        "driveWebViewLink": {
          "type": "string",
          "description": "Optional Google Drive webViewLink URL for the backed-up full-resolution file.",
          "minLength": 0,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the portfolio asset was saved."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the portfolio asset was last updated."
        }
      },
      "required": [
        "ownerId",
        "category",
        "title",
        "prompt",
        "service",
        "aspectRatio",
        "modelUsed",
        "previewDataUrl",
        "svgMarkup",
        "durationLabel",
        "interactionId",
        "driveFileId",
        "driveWebViewLink",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Top-level saved ad campaigns isolated per authenticated owner."
    },
    "/campaigns/{campaignId}/ads/{adId}": {
      "schema": "AdVariation",
      "description": "Subcollection of generated ad variations belonging to a parent campaign."
    },
    "/creativeAssets/{assetId}": {
      "schema": "CreativeAsset",
      "description": "Top-level portfolio storage for generated ad images, video ads, logos, and icons isolated per authenticated owner."
    }
  }
}
